# Copy this to android/keystore.properties and fill in the three blanks.
# That file is gitignored and must never be committed.
#
# ---------------------------------------------------------------------------
# USE gsm-release.jks. It is the key the published app is already signed with.
# ---------------------------------------------------------------------------
#
# The V1 app published at https://genuinesugarmummies.co.ke/base-release.apk
# is ke.co.genuinesugarmummies.app versionCode 1, signed with:
#
#   CN=Genuine Sugar Mummies, OU=Mobile, O=Genuine Sugar Mummies, L=Nairobi, C=KE
#   SHA-256 6b698972405d7e00856c368e0643ce964385f7ac96fba2ef27816ca2cdc538bc
#
# That fingerprint belongs to gsm-release.jks, which also signed the V2 app.
#
# Why this matters more than anything else in this file: Android only allows an
# app to be replaced by one signed with the same key. Sign a new release with
# gsm-release.jks and every member updates in place, keeping their data and
# staying signed in. Sign it with any other key and every member has to
# uninstall first, which is the difference between an update people accept and
# one most of them abandon.
#
# There is a second keystore here, gs-kenya-release.jks, generated on
# 2026-08-12 before the published APK was found. Do not use it: it produces a
# build that cannot update anybody who already has the app.
#
# To find the alias inside the keystore:
#   & "C:\Program Files\Android\Android Studio\jbr\bin\keytool.exe" `
#       -list -v -keystore android\keystores\gsm-release.jks

storeFile=keystores/gsm-release.jks

# The password for the keystore file.
storePassword=

# The key name inside it, from the keytool command above.
keyAlias=

# The password for that key. Often the same as storePassword.
keyPassword=
