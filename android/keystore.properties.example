# Copy this file to android/keystore.properties and fill in the four values.
# That file is gitignored and must never be committed.
#
# Signing was done by hand in Android Studio before, so the password was retyped
# on every release and nothing recorded which key was the correct one. With this
# file present, `gradlew assembleRelease` produces a signed APK in one command.
#
# V1 has never had a published release, so its first signed build fixes the
# signing key permanently. Once members install it, an APK signed with any other
# key can never update them: Android refuses, and the only way forward is
# uninstall and reinstall, which loses their local state. Back the keystore up
# somewhere you will still have in two years.
#
# To find the alias inside an existing keystore:
#   & "C:\Program Files\Android\Android Studio\jbr\bin\keytool.exe" `
#       -list -v -keystore android\keystores\gsm-release.jks

# Path to the keystore, relative to the android/ directory.
storeFile=keystores/gsm-release.jks

# The password for the keystore file itself.
storePassword=

# The name of the key inside the keystore.
keyAlias=

# The password for that key. Often the same as storePassword.
keyPassword=
